{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the main window: only the listed app commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-app-info",
    "allow-list-servers",
    "allow-add-server",
    "allow-update-server",
    "allow-delete-server",
    "allow-set-server-credential",
    "allow-clear-server-credential",
    "allow-test-server-connection",
    "allow-trust-host-key",
    "allow-forget-host-key",
    "allow-list-host-keys",
    "allow-open-terminal",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-close-terminal",
    "allow-start-monitoring",
    "allow-stop-monitoring",
    "allow-list-alert-rules",
    "allow-add-alert-rule",
    "allow-update-alert-rule",
    "allow-delete-alert-rule",
    "allow-list-alert-events",
    "allow-clear-alert-events",
    "allow-list-active-alerts",
    "allow-list-docker-containers",
    "allow-get-container-logs"
  ]
}
